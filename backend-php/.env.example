# Copy to .env (never commit .env), then: php artisan key:generate
# On Render, set the same names in the service's Environment tab.

APP_NAME="NUML Timetable"
APP_ENV=local
# Generated by `php artisan key:generate` (Render: `php artisan key:generate --show`, paste the value).
APP_KEY=
# true only on your laptop: errors then include what broke. Always false on Render.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ------------------------------------------------------------
# Local: SQLite, nothing to install. Create the file first:
#   New-Item database/database.sqlite   (PowerShell)  or  touch database/database.sqlite
DB_CONNECTION=sqlite
# Render / Aiven: DB_CONNECTION=mysql and paste Aiven's URL unchanged, e.g.
#   DB_URL=mysql://avnadmin:PASSWORD@host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# DB_URL=
# Path to Aiven's CA certificate, so the server is verified, not only encrypted
# (Render: upload it as a Secret File, then /etc/secrets/<file name>).
# DB_SSL_CA=

# --- Auth / JWT ------------------------------------------------------------
# Required. At least 32 characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS --------------------------------------------------------------------
# Comma-separated frontend addresses (Live Server must use port 5500).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Optional regexes, e.g. Netlify deploy previews:
# CORS_ORIGIN_PATTERNS=#^https://deploy-preview-\d+--numl-archive\.netlify\.app$#

# --- File uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
FILESYSTEM_DISK=local
# Supabase Storage (S3) later, for uploads that survive a Render restart:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Email codes (signup, forgot password) ----------------------------------------
# console = the code is written to storage/logs/laravel.log, nothing is sent.
# Keep console locally and in CI. Render: brevo + the three values below.
EMAIL_PROVIDER=console
# BREVO_API_KEY=
# EMAIL_FROM=
EMAIL_FROM_NAME="NUML Timetable"

# --- Laravel internals (no need to change) ---------------------------------------
# The API keeps no sessions; the cache only holds the /docs page and rate limits.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
