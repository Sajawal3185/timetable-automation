    {
      "name": "6. Teacher books a makeup class",
      "item": [
        {
          "name": "Teacher: find free slots (90 min)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/makeup/find-slots",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacherToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"section_id\": {{makeupSectionId}},\n  \"teacher_id\": {{teacherTeacherId}},\n  \"course_id\": {{makeupCourseId}},\n  \"duration_minutes\": 90\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json();",
                  "pm.test(\"at least one free slot\", () => pm.expect(slots.length).to.be.above(0));",
                  "pm.test(\"lecture rooms only\", () => slots.forEach(s => pm.expect(s.recommended_room.room_type).to.eql(\"lecture\")));",
                  "const s = slots[0];",
                  "pm.collectionVariables.set(\"makeupRoomId\", s.recommended_room.room_id);",
                  "pm.collectionVariables.set(\"makeupDay\", s.day_of_week);",
                  "pm.collectionVariables.set(\"makeupStart\", s.start_time);",
                  "pm.collectionVariables.set(\"makeupEnd\", s.end_time);"
                ]
              }
            }
          ]
        },
