    {
      "name": "3. Teacher asks for a swap (clash refused, free slot pending)",
      "item": [
        {
          "name": "Teacher: my timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/timetable?teacher_id={{teacherTeacherId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacherToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function find(day, start) {",
                  "    const e = pm.response.json().find(x => x.day_of_week === day && x.start_time.startsWith(start));",
                  "    pm.expect(e, day + \" \" + start).to.exist;",
                  "    return e;",
                  "}",
                  "",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "// Dr. Ahmed Raza's classes used by the demo (see backend/scripts/seed.py)",
                  "const mon = find(\"Monday\", \"08:30\");      // SE-311, BSSE-5A",
                  "const wed = find(\"Wednesday\", \"10:00\");   // SE-311, BSSE-5A",
                  "pm.collectionVariables.set(\"clashEntryId\", mon.id);",
                  "pm.collectionVariables.set(\"freeEntryId\", wed.id);",
                  "pm.collectionVariables.set(\"makeupSectionId\", mon.section_id);",
                  "pm.collectionVariables.set(\"makeupCourseId\", mon.course_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "HOD's classes (the swap targets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/timetable?teacher_id={{hodTeacherId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{hodToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function find(day, start) {",
                  "    const e = pm.response.json().find(x => x.day_of_week === day && x.start_time.startsWith(start));",
                  "    pm.expect(e, day + \" \" + start).to.exist;",
                  "    return e;",
                  "}",
                  "",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "// Ms. Sara Khan's classes: Mon 10:00 SE-312 (5A) clashes, Wed 08:30 SE-315 (5B) is free",
                  "pm.collectionVariables.set(\"clashTargetId\", find(\"Monday\", \"10:00\").id);",
                  "pm.collectionVariables.set(\"freeTargetId\", find(\"Wednesday\", \"08:30\").id);"
                ]
              }
            }
          ]
        },
