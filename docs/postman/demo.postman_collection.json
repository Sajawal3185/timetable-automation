                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const id = Number(pm.collectionVariables.get(\"makeupId\"));",
                  "pm.test(\"the booked makeup is listed\", () => pm.expect(pm.response.json().map(m => m.id)).to.include(id));"
                ]
              }
            }
          ]
        },
