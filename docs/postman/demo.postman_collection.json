{
  "info": {
    "name": "Timetable demo (Part 8 demo, top to bottom)",
    "description": "Task X-1. Runs the 5-minute demo from docs/release-plan.md Part 8 against the API, in order.\n\nBefore every run: `SEED_PASSWORD=... python -m scripts.seed --reset` on the target database.\nSet the collection variables `baseUrl` (local or the Render URL) and `password` (= SEED_PASSWORD, as Current value only, so it is never exported). Then Run collection.\n\nEvery request has tests; all of them pass on a freshly reset seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Wake the server",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"server is up\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
