{
  "info": {
    "name": "Timetable Automation - Wajiha's endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set base_url (default http://127.0.0.1:8000) and token (JWT from Sajawal's login endpoint) as collection/environment variables. Never save a real token in this file."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Timetable import & view",
      "item": [
        {
          "name": "Preview import (dry run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/timetable/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "timetable",
                "import"
              ]
            },
            "description": "Admin/HOD. Select backend/data/sample_timetables/sample_SE_flat.xlsx",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "department_code",
                  "value": "SE",
                  "type": "text"
                },
                {
                  "key": "dry_run",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Import for real",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
