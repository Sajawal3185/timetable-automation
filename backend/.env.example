# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. NEVER commit real secrets.

# Required. SQLAlchemy URL. Local MySQL example:
DATABASE_URL=mysql+pymysql://timetable_user:change-me@localhost:3306/timetable

# Required. Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional (defaults shown)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
